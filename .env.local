# Market Petronio API — env reference (placeholders only)
# Copy values into a gitignored `.env` file with real secrets.
# Load order: `.env` overrides `.env.local`.

NODE_ENV=development
PORT=3000
API_PREFIX=api
# Frontend origin(s) for CORS — comma-separated if multiple
# Example: http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/market-petronio?retryWrites=true&w=majority

# JWT (access + refresh). Secrets must be at least 32 characters.
JWT_SECRET=change-me-access-token-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-token
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (profile + product images via ImagesModule adapter)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Resend) — swap provider via EMAIL_SENDER adapter factory in NotificationsModule
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@example.com
# Frontend base URL used in email CTAs
PLATFORM_URL=http://localhost:5173

# Redis (OTP password recovery + optional cache)
REDIS_URL=redis://127.0.0.1:6379

# Cache TTLs (seconds) — Redis is never source of truth
CACHE_TTL_CATEGORIES_SECONDS=3600
CACHE_TTL_TAGS_SECONDS=600
CACHE_TTL_LOCATIONS_SECONDS=86400
CACHE_TTL_LOCATION_SEARCH_SECONDS=3600

# Google Maps (backend-only; Places Autocomplete New + Place Details)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_TIMEOUT_MS=4000
